# Copy to .env. The service runs fully WITHOUT any of these — see TRIAGE_MODE=replay.
#
# replay : no network, no key. Reads recorded model responses from fixtures/replay/.
#          This is the default, and the mode CI runs in.
# live   : calls the real model. Requires ANTHROPIC_API_KEY.
TRIAGE_MODE=replay

# Only read when TRIAGE_MODE=live.
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-sonnet-5

PORT=3000
LOG_LEVEL=info

# Optional. When set, POST /triage requires `authorization: Bearer <token>`.
# Left unset so a clean clone runs without one.
TRIAGE_AUTH_TOKEN=

# Concurrent model calls before shedding. Set to 0 to see the degraded path.
TRIAGE_MAX_CONCURRENT_MODEL_CALLS=8
